# coast_ui 설정 견본 — 복사해서 .env.local 로 (git 제외). 이미 설정된 환경변수가 이긴다.
# 판정 산출물이 있는 ml_all 저장소 (상대경로는 이 저장소 뿌리 기준)
AISINT_ML_ALL_ROOT=../ais_integrity_ml_all
# 지도 타일 ({z}/{x}/{y}). 타일 서버가 없으면 배경 없이 항행수역 윤곽만 그린다
COAST_TILE_URL=http://localhost:8080/styles/dark-matter/{z}/{x}/{y}.png
# run_coast.ps1 기본 포트 (-Port 인자가 이긴다)
COAST_PORT=8800
# 프런트 폴링 주기(ms). 0 = 꺼짐 (LiveProvider 가 붙으면 켠다)
COAST_POLL_MS=0
